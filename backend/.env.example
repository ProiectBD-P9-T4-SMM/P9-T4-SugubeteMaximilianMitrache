# Backend Environment Variables

# ─── Server ───────────────────────────────────────────────────────────────
# Port the backend listens on
PORT=3000

# CORS allowed origins (comma-separated)
# Local dev:   http://localhost:5173
# GitHub Pages: https://proiectbd-p9-t4-smm.github.io
# Same-origin demo (compose): http://localhost:8080
ALLOWED_ORIGINS=http://localhost:5173,https://proiectbd-p9-t4-smm.github.io

# Serve the built frontend from this same process (optional).
# SERVE_FRONTEND=1
# FRONTEND_DIR=../dist

# ─── Database ─────────────────────────────────────────────────────────────
# PostgreSQL connection used by the API (src/db.js)
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name

# Same database as a single URL; used by the one-off seed/check scripts.
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/your_db_name

# ─── Authentication ───────────────────────────────────────────────────────
# JWT secret key (use a strong, random value outside the demo)
JWT_SECRET=your_jwt_secret_key_change_in_production
# Secret used by the mock university SSO (only for local/demo use)
SSO_MOCK_SECRET=your_mock_sso_secret

# ─── Email ────────────────────────────────────────────────────────────────
# Email provider: mock, smtp, or graph
EMAIL_PROVIDER=mock

# Microsoft Graph Email Configuration (if using GRAPH provider)
GRAPH_TENANT_ID=your_tenant_id
GRAPH_CLIENT_ID=your_client_id
GRAPH_CLIENT_SECRET=your_client_secret
GRAPH_SENDER_EMAIL=noreply@yourdomain.com

# SMTP Email Configuration (if using SMTP provider)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_specific_password
